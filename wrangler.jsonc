// Cloudflare Workers: serve the built app (dist/) as static assets. No server code.
// Deploy command: npx wrangler deploy (it builds first, so no separate build command is needed)
{
  "name": "mindweb-mymap",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "npm run build"
  },
  // needed by `wrangler preview`, which Cloudflare runs for branches other than main; empty is fine
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
